extends Node

## Автозагружаемый флаг "идёт диалог прямо сейчас" - просто читаемое
## состояние, без логики. Заменяет get_tree().paused как способ
## "заморозить обычный ввод игрока во время диалога" - в отличие от
## паузы дерева, этот флаг не глушит ничьи _physics_process целиком, а
## только читается там, где это осознанно нужно (см. player.tscn.gd) -
## поэтому не может конфликтовать с другими системами, которые тоже
## хотят использовать паузу дерева независимо (см. arena.gd/GameOverUI).

var is_active: bool = false
